{
  "name": "@tanisten/learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true, maxRetries: 5, retryDelay: 200 })\"",
    "build": "npm run clean && next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:rls": "supabase test db supabase/tests"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.40.2"
  }
}
